{
  "name": "@rbxts/input-actions",
  "version": "0.7.0",
  "description": "A typed wrapper over Roblox's Input Action System for roblox-ts: schema-defined contexts, actions and bindings, rebinding with JSON saves, Server Authority, and mouse and raw-input utilities.",
  "main": "out/init.luau",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "roblox-ts",
    "input",
    "input-action-system",
    "ias",
    "controller",
    "gamepad",
    "keyboard",
    "mouse",
    "touch",
    "actions",
    "rebinding"
  ],
  "author": "Catargo",
  "license": "MIT",
  "files": [
    "out",
    "!**/*.tsbuildinfo",
    "default.project.json",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/types": "^1.0.956",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-roblox-ts": "^0.0.36",
    "prettier": "^3.4.2",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@rbxts/services": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velover/input-actions.git"
  },
  "bugs": {
    "url": "https://github.com/Velover/input-actions/issues"
  },
  "homepage": "https://github.com/Velover/input-actions#readme",
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
