{
	// Type-checks type-rules.ts with plain tsc (roblox-ts refuses @ts-expect-error in compiled
	// source). Run by `bun run build` and `bun run test`: an unused @ts-expect-error fails them.
	"compilerOptions": {
		"noLib": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"target": "ESNext",
		"module": "commonjs",
		"moduleResolution": "Node",
		"moduleDetection": "force",
		"downlevelIteration": true,
		"allowSyntheticDefaultImports": true,
		"typeRoots": ["../../node_modules/@rbxts"],
		"types": ["types", "compiler-types"]
	},
	"files": ["type-rules.ts", "validator-r1-type-rules.ts", "validator-r3-type-rules.ts", "validator-r4-type-rules.ts", "validator-r5-type-rules.ts", "validator-r6-type-rules.ts", "capture-chord-type-rules.ts", "attach-label-type-rules.ts", "hunter-chord-type-rules.ts", "hunter-chord-2-type-rules.ts", "hunter-label-2-type-rules.ts", "devices-type-rules.ts", "hunter-devices-type-rules.ts", "hunter-devices-2-type-rules.ts", "hunter-devices-3-type-rules.ts", "hunter-devices-4-type-rules.ts", "device-extras-type-rules.ts", "features-type-rules.ts", "hunter-features-type-rules.ts"]
}
